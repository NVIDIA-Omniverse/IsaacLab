{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commit",
  "description": "Schema for one commit entry in commits.json",
  "type": "object",
  "required": ["sha", "date", "author", "message", "dep_files_changed"],
  "properties": {
    "sha": {
      "type": "string",
      "description": "Full commit SHA"
    },
    "short_sha": {
      "type": "string",
      "description": "Abbreviated commit SHA (first 7-8 chars)"
    },
    "date": {
      "type": "string",
      "description": "ISO 8601 commit timestamp, e.g. 2026-06-01T12:00:00Z"
    },
    "author": {
      "type": "string",
      "description": "Commit author name"
    },
    "message": {
      "type": "string",
      "description": "Full commit message"
    },
    "dep_files_changed": {
      "type": "boolean",
      "description": "True if any dependency file (requirements.txt, setup.cfg, pyproject.toml, requirements/*.txt) was modified"
    }
  },
  "additionalProperties": false
}
