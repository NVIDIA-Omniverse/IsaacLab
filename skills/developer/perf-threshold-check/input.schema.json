{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isaac-sim.github.io/IsaacLab/schemas/perf-threshold-check-input-v1.json",
  "title": "Isaac Lab performance threshold request",
  "type": "object",
  "required": [
    "schema_version",
    "operation",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "const": "threshold_check"
    },
    "mode": {
      "enum": [
        "ci_gate",
        "paired_reference"
      ]
    },
    "bench_result_path": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "median_fps",
        "mad_fps"
      ],
      "properties": {
        "median_fps": {
          "type": "number"
        },
        "mad_fps": {
          "type": "number",
          "minimum": 0
        },
        "k_warn": {
          "type": "number"
        },
        "k_block": {
          "type": "number"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "total_sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fps_mean_thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "threshold_name",
          "threshold"
        ],
        "properties": {
          "threshold_name": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "number"
          },
          "threshold_verdict": {
            "enum": [
              "WARN",
              "BLOCK",
              null
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "min_block_regression_pct": {
      "type": "number",
      "minimum": 0
    },
    "noise_floor_pct": {
      "type": "number",
      "minimum": 0
    },
    "comparison": {
      "enum": [
        "check_reference",
        "compare_candidate"
      ]
    },
    "metric": {
      "$ref": "#/$defs/metric"
    },
    "measurement_policy": {
      "$ref": "#/$defs/policy"
    },
    "good_summary": {
      "$ref": "#/$defs/summary"
    },
    "bad_summary": {
      "$ref": "#/$defs/summary"
    },
    "candidate_summary": {
      "$ref": "#/$defs/summary"
    },
    "reference_noise_pct": {
      "type": "number",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "ci_gate"
          }
        }
      },
      "then": {
        "required": [
          "bench_result_path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "paired_reference"
          }
        }
      },
      "then": {
        "required": [
          "comparison",
          "metric",
          "measurement_policy",
          "good_summary"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "comparison": {
            "const": "check_reference"
          }
        },
        "required": [
          "comparison"
        ]
      },
      "then": {
        "required": [
          "bad_summary"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "comparison": {
            "const": "compare_candidate"
          }
        },
        "required": [
          "comparison"
        ]
      },
      "then": {
        "required": [
          "candidate_summary"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "result_path": {
          "type": "string",
          "minLength": 1
        },
        "regression_direction": {
          "enum": [
            "decrease",
            "increase"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "reference_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_reference_runs": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_candidate_runs": {
          "type": "integer",
          "minimum": 1
        },
        "min_regression_pct": {
          "type": "number",
          "minimum": 0
        },
        "gray_zone_pct": {
          "type": "number",
          "minimum": 0
        },
        "reference_noise_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "max_reference_spread_pct": {
          "type": "number",
          "minimum": 0
        },
        "warmup_runs": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "label",
        "metric_name",
        "unit",
        "values",
        "median_value",
        "mean_value",
        "min_value",
        "max_value",
        "sample_count",
        "spread_pct"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "metric_name": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "median_value": {
          "type": "number"
        },
        "mean_value": {
          "type": "number"
        },
        "min_value": {
          "type": "number"
        },
        "max_value": {
          "type": "number"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "spread_pct": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
